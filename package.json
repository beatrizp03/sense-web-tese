{
  "name": "@scientisst/sense-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "dev:desktop": "concurrently -k \"pnpm --filter sense-web dev\" \"wait-on http://localhost:3000 && pnpm --filter sense-desktop start\""
  },
  "devDependencies": {
    "@scientisst/eslint-config-next": "workspace:*",
    "@scientisst/prettier-config": "workspace:*",
    "concurrently": "^9.2.1",
    "turbo": "^1.7.3",
    "typescript": "^5.9.3",
    "wait-on": "^9.0.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@10.30.1"
}